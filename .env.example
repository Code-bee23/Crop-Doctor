# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
MEDIA_STORAGE_DIR=storage

# WhatsApp Cloud API (Meta for Developers)
# Get these from Meta Business Suite / Developer Portal
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_ACCESS_TOKEN=your_whatsapp_system_user_or_temporary_token_here
WHATSAPP_VERIFY_TOKEN=crop_doctor_webhook_secret_verify_token_2026
WHATSAPP_API_VERSION=v19.0

# Database (Supabase PostgreSQL with pgvector)
SUPABASE_URL=https://your-project-id.supabase.co
